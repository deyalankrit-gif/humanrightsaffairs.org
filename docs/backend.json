
{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Administrative, Member, or Investigator account with specific permission toggles and linked Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Linked Firebase Authentication UID." },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "investigator", "member"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": { "type": "object" }
      }
    },
    "Investigator": {
      "title": "Investigator Profile",
      "description": "Specialized personnel authorized for field investigations.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "employeeId": { "type": "string" },
        "password": { "type": "string", "description": "Login credential for the investigator portal." },
        "designation": { "type": "string" },
        "region": { "type": "string" },
        "assignedCount": { "type": "number" }
      }
    },
    "DeletionAuditLog": {
      "title": "Deletion Audit Log",
      "description": "Immutable record of personnel records purged by Super Admin.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetEmail": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    },
    "WebsiteScan": {
      "title": "Website SEO Scan",
      "description": "Detailed snapshot of website technical health and SEO performance.",
      "type": "object",
      "properties": {
        "healthScore": { "type": "number" },
        "seoScore": { "type": "number" },
        "criticalErrors": { "type": "number" },
        "brokenLinks": { "type": "number" },
        "indexedPages": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "summary": { "type": "object" }
      }
    },
    "SeoTask": {
      "title": "SEO Action Task",
      "description": "Individual actionable task derived from website health scans.",
      "type": "object",
      "properties": {
        "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "issue": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved", "Ignored"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{email}": { "schema": "UserAccount" },
    "/public_complaints/{id}": { "description": "Primary complaint registry linked to investigators via assignment fields." },
    "/investigation_officers/{id}": { "schema": "Investigator" },
    "/deletion_audit_logs/{id}": { "schema": "DeletionAuditLog" },
    "/website_scans/{id}": { "schema": "WebsiteScan" },
    "/seo_tasks/{id}": { "schema": "SeoTask" },
    "/seo_rankings/{id}": { "description": "Historical keyword ranking data" }
  }
}
