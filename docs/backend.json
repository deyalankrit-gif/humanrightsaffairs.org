{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Administrative account with specific permission toggles and linked Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Linked Firebase Authentication UID." },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": {
          "type": "object",
          "properties": {
            "analytics": { "type": "boolean" },
            "memberAnalytics": { "type": "boolean" },
            "members": { "type": "boolean" },
            "visitors": { "type": "boolean" },
            "accounts": { "type": "boolean" },
            "expenses": { "type": "boolean" },
            "applications": { "type": "boolean" },
            "inventory": { "type": "boolean" },
            "vendors": { "type": "boolean" },
            "grievances": { "type": "boolean" },
            "meetings": { "type": "boolean" },
            "events": { "type": "boolean" },
            "gallery": { "type": "boolean" },
            "publicView": { "type": "boolean" },
            "terminated": { "type": "boolean" },
            "renewals": { "type": "boolean" },
            "activityHub": { "type": "boolean", "description": "Access to manage Activity Calendar Hub." },
            "occasions": { "type": "boolean", "description": "Access to manage Festival & Occasion greetings." },
            "donorWall": { "type": "boolean", "description": "Access to manage Wall of Donors recognition." },
            "publicComplaints": { "type": "boolean", "description": "Access to review public human rights complaints." },
            "kitManagement": { "type": "boolean", "description": "Access to manage official kits and member assets." }
          }
        },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID of the administrator who provisioned this account." }
      },
      "required": ["email", "permissions", "uid", "role"]
    },
    "ActivityEvent": {
      "title": "Activity Event",
      "description": "Organizational activity for the Hub.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "venue": { "type": "string" },
        "organizer": { "type": "string" },
        "responsiblePerson": { "type": "string" },
        "budget": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Planned", "Confirmed", "Completed", "Cancelled"] },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "date", "category", "status"]
    },
    "PublicComplaint": {
      "title": "Public Complaint",
      "description": "A formal human rights violation report submitted by a citizen.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "fullName": { "type": "string" },
        "relationName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "aadhaar": { "type": "string" },
        "address": { "type": "string" },
        "incidentDate": { "type": "string" },
        "incidentLocation": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Resolved"] },
        "incidentPhotos": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MemberKit": {
      "title": "Member Kit",
      "description": "Tracking of official materials issued to a member.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "items": {
          "type": "object",
          "properties": {
            "identityCard": { "type": "boolean" },
            "lanyard": { "type": "boolean" },
            "cardHolder": { "type": "boolean" },
            "vehicleSticker": { "type": "boolean" },
            "badge": { "type": "boolean" },
            "appointmentLetter": { "type": "boolean" },
            "membershipCertificate": { "type": "boolean" },
            "designationCarPlate": { "type": "boolean" },
            "approvalLetterCarPlate": { "type": "boolean" },
            "letterhead": { "type": "boolean" },
            "officeSeal": { "type": "boolean" }
          }
        },
        "dispatchDate": { "type": "string", "format": "date" },
        "courierDetails": { "type": "string" },
        "deliveryStatus": { "type": "string", "enum": ["Pending", "Dispatched", "In Transit", "Delivered", "Returned"] },
        "acknowledgementReceived": { "type": "boolean" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userEmail}": { "schema": "UserAccount", "description": "Permissions registry." },
    "/activity_events/{eventId}": { "schema": "ActivityEvent" },
    "/public_complaints/{complaintId}": { "schema": "PublicComplaint", "description": "Public human rights reports." },
    "/member_kits/{memberId}": { "schema": "MemberKit", "description": "Member asset tracking." }
  }
}