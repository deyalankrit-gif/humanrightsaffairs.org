
{
  "entities": {
    "Donation": {
      "title": "Donation",
      "description": "Details of a donation made to the Human Rights Affairs Trust.",
      "type": "object",
      "properties": {
        "donorName": { "type": "string" },
        "donorEmail": { "type": "string", "format": "email" },
        "amount": { "type": "number" },
        "pan": { "type": "string" },
        "aadhaar": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MemberProfile": {
      "title": "Member Profile",
      "description": "Detailed profile information for verified members.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "profession": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "level": { "type": "string", "enum": ["National", "State", "District"] },
        "stateName": { "type": "string" },
        "districtName": { "type": "string" },
        "status": { "type": "string" },
        "memberId": { "type": "string" },
        "joiningDate": { "type": "string", "description": "Membership Date of Issue" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MemberApplication": {
      "title": "Member Application",
      "description": "Registration requests from prospective members.",
      "type": "object",
      "properties": {
        "referenceId": { "type": "string", "description": "Unique generated tracking ID for the application." },
        "photoDataUri": { "type": "string", "description": "Applicant's profile picture as a data URI." },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "pan": { "type": "string" },
        "aadhaar": { "type": "string" },
        "profession": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "education": { "type": "string", "description": "Educational qualifications of the applicant." },
        "experience": { "type": "string", "description": "Prior work or social service experience." },
        "level": { "type": "string", "enum": ["National", "State", "District"] },
        "stateName": { "type": "string" },
        "districtName": { "type": "string" },
        "memberType": { "type": "string", "enum": ["Executive Designation", "Regular Member", "Volunteer"] },
        "membershipDuration": { "type": "string", "enum": ["1 Year", "2 Years", "3 Years"] },
        "hasNoCriminalRecord": { "type": "boolean", "description": "Affidavit declaring no past criminal records." },
        "hasAcceptedDeclaration": { "type": "boolean", "description": "Agreement to organizational rules and suspension policy." },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Approved", "Rejected", "Archived"] },
        "statusUpdateReason": { "type": "string", "description": "Reason for the current status (approval, rejection, or archival)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "memberType", "gender", "hasNoCriminalRecord", "hasAcceptedDeclaration", "membershipDuration", "referenceId"]
    },
    "Event": {
      "title": "Event",
      "description": "Organizational events and mission highlights.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "imageId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TerminatedMember": {
      "title": "Terminated Member",
      "description": "Public notice of revoked or cancelled memberships.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "terminationDate": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "LeadershipMember": {
      "title": "Leadership Member",
      "description": "Personnel in the organizational hierarchy tree.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "level": { "type": "string" },
        "parentRegion": { "type": "string" },
        "districtName": { "type": "string" },
        "gender": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "GeneralMeeting": {
      "title": "General Meeting",
      "description": "Records of official organizational assemblies and meetings.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "agenda": { "type": "string" },
        "minutes": { "type": "string" },
        "level": { "type": "string", "enum": ["National", "State", "District"] },
        "stateName": { "type": "string" },
        "districtName": { "type": "string" },
        "status": { "type": "string", "enum": ["Upcoming", "Completed", "Postponed"] },
        "attendees": { "type": "array", "items": { "type": "string" }, "description": "Names of leadership members present at the meeting." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "level"]
    },
    "Grievance": {
      "title": "Member Grievance",
      "description": "Complaints and grievances submitted by members.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "memberId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/donations/{donationId}": { "schema": "Donation" },
    "/memberProfiles/{profileId}": { "schema": "MemberProfile" },
    "/memberApplications/{appId}": { "schema": "MemberApplication" },
    "/events/{eventId}": { "schema": "Event" },
    "/terminatedMembers/{memberId}": { "schema": "TerminatedMember" },
    "/leadership/{leaderId}": { "schema": "LeadershipMember" },
    "/meetings/{meetingId}": { "schema": "GeneralMeeting" },
    "/grievances/{grievanceId}": { "schema": "Grievance" }
  }
}
