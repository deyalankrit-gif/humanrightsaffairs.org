
{
  "entities": {
    "Donation": {
      "title": "Donation",
      "description": "Details of a donation made to the Human Rights Affairs Trust.",
      "type": "object",
      "properties": {
        "donorName": { "type": "string" },
        "donorEmail": { "type": "string", "format": "email" },
        "donorPhone": { "type": "string" },
        "donorAddress": { "type": "string" },
        "panNumber": { "type": "string" },
        "aadhaarNumber": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR"] },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "donorPhotoUrl": { "type": "string" }
      },
      "required": ["donorName", "donorEmail", "amount", "panNumber"]
    },
    "MemberProfile": {
      "title": "Member Profile",
      "description": "Detailed profile information for verified members, including sensitive contact details.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "joiningDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["memberId", "name", "email", "phone"]
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/donations/{donationId}": {
      "schema": "Donation",
      "description": "Collection of all donations received."
    },
    "/memberProfiles/{profileId}": {
      "schema": "MemberProfile",
      "description": "Secure member profiles accessible only to authenticated internal users."
    }
  }
}
