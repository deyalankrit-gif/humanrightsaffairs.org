
{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Administrative account with specific permission toggles and linked Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Linked Firebase Authentication UID." },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "national_finance", "state_finance", "auditor"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": {
          "type": "object",
          "properties": {
            "analytics": { "type": "boolean" },
            "memberAnalytics": { "type": "boolean" },
            "members": { "type": "boolean" },
            "visitors": { "type": "boolean" },
            "accounts": { "type": "boolean" },
            "expenses": { "type": "boolean" },
            "applications": { "type": "boolean" },
            "inventory": { "type": "boolean" },
            "materialManagement": { "type": "boolean", "description": "Access to the high-fidelity Material Management System." },
            "vendors": { "type": "boolean" },
            "grievances": { "type": "boolean" },
            "meetings": { "type": "boolean" },
            "events": { "type": "boolean" },
            "gallery": { "type": "boolean" },
            "publicView": { "type": "boolean" },
            "terminated": { "type": "boolean" },
            "renewals": { "type": "boolean" },
            "activityHub": { "type": "boolean" },
            "occasions": { "type": "boolean" },
            "donorWall": { "type": "boolean" },
            "publicComplaints": { "type": "boolean" },
            "kitManagement": { "type": "boolean" },
            "financeDashboard": { "type": "boolean" },
            "financeLedger": { "type": "boolean" },
            "financeVouchers": { "type": "boolean" },
            "financePayroll": { "type": "boolean" },
            "financeProjects": { "type": "boolean" },
            "financeAssets": { "type": "boolean" },
            "financeCompliance": { "type": "boolean" }
          }
        },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["email", "permissions", "uid", "role"]
    },
    "MaterialItem": {
      "title": "Material Item",
      "description": "Logistical asset or supply in the material management system.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "unit": { "type": "string" },
        "currentStock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "status": { "type": "string", "enum": ["Available", "Low Stock", "Out of Stock"] },
        "location": { "type": "string" },
        "lastProcured": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CurrentNews": {
      "title": "Current News",
      "description": "Daily news broadcast for the homepage display area.",
      "type": "object",
      "properties": {
        "originalEnglish": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "category": { "type": "string" }
          }
        },
        "bengaliTranslation": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "category": { "type": "string" }
          }
        },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Feedback": {
      "title": "Public Feedback",
      "description": "Feedback submitted by users on the website.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "comment": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "address", "comment"]
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userEmail}": { "schema": "UserAccount", "description": "Permissions registry." },
    "/materials/{materialId}": { "schema": "MaterialItem", "description": "Material management inventory." },
    "/current_news/{newsId}": { "schema": "CurrentNews", "description": "Homepage news broadcast." },
    "/feedback/{feedbackId}": { "schema": "Feedback", "description": "User feedback collection." }
  }
}
