
{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Administrative account with specific permission toggles and linked Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Linked Firebase Authentication UID." },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": {
          "type": "object",
          "properties": {
            "analytics": { "type": "boolean" },
            "memberAnalytics": { "type": "boolean" },
            "members": { "type": "boolean" },
            "visitors": { "type": "boolean" },
            "accounts": { "type": "boolean" },
            "expenses": { "type": "boolean" },
            "applications": { "type": "boolean" },
            "inventory": { "type": "boolean" },
            "vendors": { "type": "boolean" },
            "grievances": { "type": "boolean" },
            "meetings": { "type": "boolean" },
            "events": { "type": "boolean" },
            "gallery": { "type": "boolean" },
            "publicView": { "type": "boolean" },
            "terminated": { "type": "boolean" },
            "renewals": { "type": "boolean" },
            "activityHub": { "type": "boolean", "description": "Access to manage Activity Calendar Hub." },
            "occasions": { "type": "boolean", "description": "Access to manage Festival & Occasion greetings." },
            "donorWall": { "type": "boolean", "description": "Access to manage Wall of Donors recognition." }
          }
        },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID of the administrator who provisioned this account." }
      },
      "required": ["email", "permissions", "uid", "role"]
    },
    "ActivityEvent": {
      "title": "Activity Event",
      "description": "Organizational activity for the Hub.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "venue": { "type": "string" },
        "organizer": { "type": "string" },
        "responsiblePerson": { "type": "string" },
        "budget": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Planned", "Confirmed", "Completed", "Cancelled"] },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "date", "category", "status"]
    },
    "ActivityReminder": {
      "title": "Personal Reminder",
      "description": "Private reminder for an individual user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "eventId": { "type": "string" },
        "daysBefore": { "type": "number" },
        "remindAt": { "type": "string", "format": "date-time" },
        "notified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "daysBefore"]
    },
    "Occasion": {
      "title": "Occasion Greeting",
      "description": "Banner and message for festivals or special events on the homepage.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "imageUrl": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "isActive": { "type": "boolean" },
        "priority": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "startDate", "endDate", "isActive"]
    },
    "DonorTier": {
      "title": "Donor Tier",
      "description": "Recognition level for benefactors on the Wall of Donors.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string", "description": "Tailwind CSS gradient classes." },
        "iconName": { "type": "string", "description": "Lucide icon identifier." },
        "members": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "members", "priority"]
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userEmail}": { "schema": "UserAccount", "description": "Permissions registry." },
    "/activity_events/{eventId}": { "schema": "ActivityEvent" },
    "/activity_reminders/{reminderId}": { "schema": "ActivityReminder" },
    "/occasions/{occasionId}": { "schema": "Occasion", "description": "Festival and special occasion banner registry." },
    "/donor_tiers/{tierId}": { "schema": "DonorTier", "description": "Wall of Donors recognition levels." }
  }
}
