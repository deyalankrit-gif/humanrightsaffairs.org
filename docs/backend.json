
{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Administrative account with specific permission toggles and linked Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Linked Firebase Authentication UID." },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "national_finance", "state_finance", "auditor"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "permissions": {
          "type": "object",
          "properties": {
            "analytics": { "type": "boolean" },
            "memberAnalytics": { "type": "boolean" },
            "members": { "type": "boolean" },
            "visitors": { "type": "boolean" },
            "accounts": { "type": "boolean" },
            "expenses": { "type": "boolean" },
            "applications": { "type": "boolean" },
            "inventory": { "type": "boolean" },
            "vendors": { "type": "boolean" },
            "grievances": { "type": "boolean" },
            "meetings": { "type": "boolean" },
            "events": { "type": "boolean" },
            "gallery": { "type": "boolean" },
            "publicView": { "type": "boolean" },
            "terminated": { "type": "boolean" },
            "renewals": { "type": "boolean" },
            "activityHub": { "type": "boolean" },
            "occasions": { "type": "boolean" },
            "donorWall": { "type": "boolean" },
            "publicComplaints": { "type": "boolean" },
            "kitManagement": { "type": "boolean" },
            "financeDashboard": { "type": "boolean", "description": "Access to Financial Dashboard & Analytics." },
            "financeLedger": { "type": "boolean", "description": "Access to General Ledger & Transactions." },
            "financeVouchers": { "type": "boolean", "description": "Ability to create and approve vouchers." },
            "financePayroll": { "type": "boolean", "description": "Management of employee salaries." },
            "financeProjects": { "type": "boolean", "description": "Project-based accounting & fund utilization." },
            "financeAssets": { "type": "boolean", "description": "Fixed asset management & depreciation." },
            "financeCompliance": { "type": "boolean", "description": "Tax and statutory compliance records." }
          }
        },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["email", "permissions", "uid", "role"]
    },
    "FinancialTransaction": {
      "title": "Financial Transaction",
      "description": "Core ledger entry for income and expenses.",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["Income", "Expense", "Contra", "Journal"] },
        "account": { "type": "string", "description": "Account head from Chart of Accounts." },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Bank", "UPI", "Cheque"] },
        "reference": { "type": "string" },
        "particulars": { "type": "string" },
        "projectId": { "type": "string", "description": "Linked project if applicable." },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "Approved", "Rejected"] },
        "attachmentUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["voucherNo", "date", "type", "amount", "status"]
    },
    "FinancialProject": {
      "title": "Financial Project",
      "description": "Project-based fund tracking.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "utilized": { "type": "number" },
        "startDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Active", "Completed", "On Hold"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FixedAsset": {
      "title": "Fixed Asset",
      "description": "Registry of organizational property and equipment.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "purchaseDate": { "type": "string", "format": "date" },
        "purchaseValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "depreciationRate": { "type": "number" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["In Use", "Maintenance", "Retired"] }
      }
    },
    "PayrollRecord": {
      "title": "Payroll Record",
      "description": "Employee monthly salary details.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "baseSalary": { "type": "number" },
        "allowances": { "type": "number" },
        "deductions": { "type": "number" },
        "netPaid": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Pending", "Paid"] }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userEmail}": { "schema": "UserAccount", "description": "Permissions registry." },
    "/finance_transactions/{txId}": { "schema": "FinancialTransaction" },
    "/finance_projects/{projectId}": { "schema": "FinancialProject" },
    "/finance_assets/{assetId}": { "schema": "FixedAsset" },
    "/finance_payroll/{recordId}": { "schema": "PayrollRecord" },
    "/finance_summary/state": { "schema": "object", "description": "Global financial state." }
  }
}
