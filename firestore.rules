
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. AUTHORIZATION HELPERS
    // All functions use pure CEL expressions to avoid syntax errors.
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function isRoot() {
      return isAuthenticated() && getUserEmail() == 'deydhritiman@gmail.com';
    }

    function isInternalStaff() {
      return isAuthenticated() && getUserEmail() == 'deyalankrit@gmail.com';
    }

    function hasPermission(permission) {
      return isRoot() || isInternalStaff() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(getUserEmail())) && 
        get(/databases/$(database)/documents/users/$(getUserEmail())).data.permissions.get(permission, false) == true
      );
    }

    // 2. GLOBAL ACCESS OVERRIDES
    // Root official has full access to the entire database for emergency governance.
    match /{document=**} {
      allow read, write: if isRoot();
    }

    // 3. PUBLIC READ ACCESS: High-priority paths readable by everyone
    match /occasions/{occasionId} {
      allow read: if true;
      allow write: if hasPermission('occasions');
    }
    
    match /donor_tiers/{tierId} {
      allow read: if true;
      allow write: if hasPermission('donorWall');
    }
    
    match /memberProfiles/{profileId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if hasPermission('events');
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if hasPermission('gallery');
    }

    match /leadership/{leaderId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }

    match /terminatedMembers/{memberId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if hasPermission('meetings');
    }

    // 4. PROTECTED ACCESS: Internal registry and administrative logs
    match /users/{userEmail} {
      allow read: if isAuthenticated() && (
        (getUserEmail() == userEmail.lower()) || 
        isRoot()
      );
      allow write: if isRoot() || (
        isInternalStaff() && userEmail.lower() == 'deyalankrit@gmail.com'
      );
    }

    match /public_complaints/{complaintId} {
      allow create: if true;
      allow read, write: if hasPermission('publicComplaints');
    }

    match /memberApplications/{appId} {
      allow create: if true;
      allow read, write: if hasPermission('applications');
    }
    
    match /donations/{donationId} {
      allow create: if true;
      allow read: if isRoot() || isInternalStaff() || hasPermission('analytics') || hasPermission('financeLedger') || hasPermission('financeDashboard');
      allow delete: if isRoot();
    }

    match /expenses/{expenseId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('expenses') || hasPermission('financeLedger');
      allow write: if isRoot() || isInternalStaff() || hasPermission('expenses');
    }

    match /accounts/{accountId} {
      allow read, write: if isRoot() || isInternalStaff() || hasPermission('accounts') || hasPermission('financeDashboard');
    }

    match /grievances/{grievanceId} {
      allow create: if true;
      allow read, write: if hasPermission('grievances');
    }

    match /inventory/{itemId} {
      allow read, write: if hasPermission('inventory');
    }

    match /vendors/{vendorId} {
      allow read, write: if hasPermission('vendors');
    }

    match /visitors/{visitorId} {
      allow create: if true;
      allow read, write: if hasPermission('visitors');
    }

    match /member_kits/{memberId} {
      allow read: if true;
      allow write: if hasPermission('kitManagement');
    }

    // 5. FINANCIAL GOVERNANCE (Enterprise Module)
    match /finance_transactions/{txId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeLedger') || hasPermission('financeDashboard');
      allow create, update: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
      allow delete: if isRoot();
    }

    match /finance_vms_vouchers/{vId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeVouchers') || hasPermission('financeDashboard');
      allow create, update: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
      allow delete: if isRoot();
    }

    match /finance_projects/{projectId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeProjects') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
    }

    match /finance_assets/{assetId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeAssets') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeAssets');
    }

    match /finance_payroll/{recordId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financePayroll') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financePayroll');
    }

    match /finance_summary/{docId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
    }

    match /finance_donors/{donorId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeLedger') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeLedger');
    }

    match /finance_compliance/{docId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeCompliance') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeCompliance');
    }

    // 6. ACTIVITY CALENDAR HUB
    match /activity_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('activityHub');
    }

    match /activity_reminders/{reminderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.uid || hasPermission('activityHub'));
      allow write: if isAuthenticated() && (request.auth.uid == resource.data.uid || hasPermission('activityHub'));
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }
  }
}
