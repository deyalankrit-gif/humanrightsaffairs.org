
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. AUTHORIZATION CORE
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(getAuthEmail())).data.role;
    }

    // High-Priority Administrative Roles
    function isRoot() {
      return isAuthenticated() && getAuthEmail() == 'deydhritiman@gmail.com';
    }

    function isInternalStaff() {
      return isAuthenticated() && (getAuthEmail() == 'deyalankrit@gmail.com' || getUserRole() == 'admin' || getUserRole() == 'staff');
    }

    function isInvestigator() {
      return isAuthenticated() && getUserRole() == 'investigator';
    }

    // Permission-based authorization
    function hasPermission(permission) {
      return isRoot() || isInternalStaff() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(getAuthEmail())) && 
        get(/databases/$(database)/documents/users/$(getAuthEmail())).data.permissions.get(permission, false) == true
      );
    }

    // 2. TRASH & RECOVERY PROTOCOL (60-DAY RETENTION)
    match /trash/{itemId} {
      // Deny access if document is older than 60 days (5184000 seconds)
      function isExpired() {
        return request.time > resource.data.deletedAt + duration.value(60, 'd');
      }
      
      allow read: if isInternalStaff() && !isExpired();
      allow create: if isInternalStaff();
      allow update: if isInternalStaff();
      allow delete: if isInternalStaff();
    }

    // 3. PUBLIC & SETTINGS (TOP PRIORITY)
    match /settings/{settingId} {
      allow get, list, read: if true;
      allow write: if isRoot() || (settingId == 'audio_announcement' && hasPermission('occasions'));
    }

    match /occasions/{occasionId} {
      allow read: if true;
      allow write: if hasPermission('occasions');
    }

    match /current_news/{newsId} {
      allow read: if true;
      allow write: if hasPermission('occasions') || isRoot(); 
    }

    match /ai_announcements/{id} {
      allow read: if true;
      allow write: if hasPermission('occasions');
    }

    match /current_news_state/{docId} {
      allow read: if true;
      allow write: if hasPermission('occasions') || isRoot();
    }
    
    match /donor_tiers/{tierId} {
      allow read: if true;
      allow write: if hasPermission('donorWall');
    }
    
    match /memberProfiles/{profileId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if hasPermission('events');
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if hasPermission('gallery');
    }

    match /leadership/{leaderId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }

    match /terminatedMembers/{memberId} {
      allow read: if true;
      allow write: if hasPermission('terminated');
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if hasPermission('meetings');
    }

    match /activity_events/{eventId} {
      allow read: if true;
      allow write: if hasPermission('activityHub');
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
    }

    match /investigation_officers/{id} {
      allow read: if true;
      allow write: if isRoot();
    }

    // 4. SECURE USER REGISTRY
    match /users/{userEmail} {
      allow read: if isAuthenticated() && (
        (getAuthEmail() == userEmail.lower()) || isRoot()
      );
      allow write: if isRoot();
    }

    // 5. PUBLIC SUBMISSIONS
    match /public_complaints/{complaintId} {
      allow create: if true;
      allow read: if hasPermission('publicComplaints') || 
        (isInvestigator() && (
          resource.data.assignedTo == get(/databases/$(database)/documents/users/$(getAuthEmail())).data.name ||
          resource.data.email == getAuthEmail() ||
          getAuthEmail() in resource.data.get('investigatorEmails', [])
        ));
      allow update: if hasPermission('publicComplaints') || isInvestigator();
    }

    match /memberApplications/{appId} {
      allow create: if true;
      allow read, write: if hasPermission('applications');
    }
    
    match /donations/{donationId} {
      allow create: if true;
      allow read: if isRoot() || isInternalStaff() || hasPermission('analytics') || hasPermission('financeLedger') || (isAuthenticated() && resource.data.email.lower() == getAuthEmail());
      allow delete: if isRoot();
    }

    match /grievances/{grievanceId} {
      allow create: if true;
      allow read, write: if hasPermission('grievances');
    }

    // 6. FINANCIAL GOVERNANCE
    match /finance_transactions/{txId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeLedger') || hasPermission('financeDashboard');
      allow create, update: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
      allow delete: if isRoot();
    }

    match /finance_vms_vouchers/{vId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeVouchers') || hasPermission('financeDashboard');
      allow create, update: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
      allow delete: if isRoot();
    }

    match /finance_projects/{projectId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeProjects') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
    }

    match /finance_assets/{assetId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeAssets') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeAssets');
    }

    match /finance_payroll/{recordId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financePayroll') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financePayroll');
    }

    match /finance_summary/{docId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeVouchers');
    }

    match /finance_compliance/{docId} {
      allow read: if isRoot() || isInternalStaff() || hasPermission('financeCompliance') || hasPermission('financeDashboard');
      allow write: if isRoot() || isInternalStaff() || hasPermission('financeCompliance');
    }

    // 7. LOGISTICS & OPERATIONAL ASSETS
    match /inventory/{itemId} {
      allow read, write: if hasPermission('inventory');
    }

    match /vendors/{vendorId} {
      allow read, write: if hasPermission('vendors');
    }

    match /member_kits/{memberId} {
      allow read, write: if hasPermission('kitManagement');
    }

    match /visitors/{visitorId} {
      allow create, update: if true;
      allow read: if hasPermission('visitors');
    }

    match /activity_reminders/{reminderId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.uid || isRoot());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    // 8. DAILY OPERATIONAL DATA
    match /daily_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /daily_notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    // 9. GLOBAL OVERRIDE (MOVED TO END)
    match /{document=**} {
      allow read, write: if isRoot();
    }
  }
}
