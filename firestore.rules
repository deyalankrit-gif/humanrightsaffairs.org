
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. PUBLIC READ ACCESS: High-priority paths readable by everyone
    match /occasions/{occasionId} {
      allow read: if true;
      allow write: if hasPermission('occasions');
    }
    
    match /donor_tiers/{tierId} {
      allow read: if true;
      allow write: if hasPermission('donorWall');
    }
    
    match /memberProfiles/{profileId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if hasPermission('events');
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if hasPermission('gallery');
    }

    match /leadership/{leaderId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }

    match /terminatedMembers/{memberId} {
      allow read: if true;
      allow write: if hasPermission('members');
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if hasPermission('meetings');
    }

    // 2. AUTHORIZATION HELPERS
    function isRoot() {
      return request.auth != null && 
             (request.auth.token.get('email', '').lower() == 'deydhritiman@gmail.com');
    }

    function isInternalStaff() {
      return request.auth != null && 
             (request.auth.token.get('email', '').lower() == 'deyalankrit@gmail.com');
    }

    function hasPermission(permission) {
      return request.auth != null && (
        isRoot() || 
        isInternalStaff() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.get('email', '').lower())) && 
         get(/databases/$(database)/documents/users/$(request.auth.token.get('email', '').lower())).data.permissions.get(permission, false) == true)
      );
    }

    // 3. PROTECTED ACCESS: Internal registry and administrative logs
    match /users/{userEmail} {
      allow read: if request.auth != null && (request.auth.token.get('email', '').lower() == userEmail.lower() || isRoot());
      allow write: if isRoot() || (request.auth != null && request.auth.token.get('email', '').lower() == 'deyalankrit@gmail.com' && userEmail.lower() == 'deyalankrit@gmail.com');
    }

    match /public_complaints/{complaintId} {
      allow create: if true;
      allow read, write: if hasPermission('publicComplaints');
    }

    match /memberApplications/{appId} {
      allow create: if true;
      allow read, write: if hasPermission('applications');
    }
    
    match /donations/{donationId} {
      allow create: if true;
      allow read: if hasPermission('analytics') || hasPermission('financeLedger');
      allow delete: if isRoot();
    }

    match /expenses/{expenseId} {
      allow read, write: if hasPermission('expenses') || hasPermission('financeLedger');
    }

    match /accounts/{accountId} {
      allow read, write: if hasPermission('accounts') || hasPermission('financeDashboard');
    }

    match /grievances/{grievanceId} {
      allow create: if true;
      allow read, write: if hasPermission('grievances');
    }

    match /inventory/{itemId} {
      allow read, write: if hasPermission('inventory');
    }

    match /vendors/{vendorId} {
      allow read, write: if hasPermission('vendors');
    }

    match /visitors/{visitorId} {
      allow create: if true;
      allow read: if hasPermission('visitors');
      allow write: if hasPermission('visitors');
    }

    match /member_kits/{memberId} {
      allow read: if true;
      allow write: if hasPermission('kitManagement');
    }

    // 4. FINANCIAL GOVERNANCE (Enterprise Module)
    match /finance_transactions/{txId} {
      allow read: if hasPermission('financeLedger');
      allow create, update: if hasPermission('financeVouchers');
      allow delete: if isRoot();
    }

    match /finance_projects/{projectId} {
      allow read: if hasPermission('financeProjects');
      allow write: if hasPermission('financeVouchers') || isRoot();
    }

    match /finance_assets/{assetId} {
      allow read: if hasPermission('financeAssets');
      allow write: if hasPermission('financeAssets') || isRoot();
    }

    match /finance_payroll/{recordId} {
      allow read: if hasPermission('financePayroll');
      allow write: if hasPermission('financePayroll') || isRoot();
    }

    match /finance_summary/{docId} {
      allow read: if hasPermission('financeDashboard');
      allow write: if hasPermission('financeVouchers') || isRoot();
    }

    // 5. ACTIVITY CALENDAR HUB
    match /activity_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if hasPermission('activityHub');
    }

    match /activity_reminders/{reminderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || hasPermission('activityHub'));
      allow write: if request.auth != null && (request.auth.uid == resource.data.uid || hasPermission('activityHub'));
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
