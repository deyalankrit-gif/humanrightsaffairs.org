
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is the designated Admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email == 'deydhritiman@gmail.com' || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Member profiles: Publicly readable for the directory, Admin write
    match /memberProfiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Membership applications: Public create, Admin read/write
    match /memberApplications/{appId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    // User roles collection for granular authorization
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    // Anyone can submit a donation for processing
    // But viewing donation records/history/analytics is restricted to the designated Admin
    match /donations/{donationId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Organizational Events: Public read, Admin write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leadership Hierarchy: Public read, Admin write
    match /leadership/{leaderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Termination Notices: Public read, Admin write
    match /terminatedMembers/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // General Meetings: Public read, Admin write
    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member Grievances: Public create only, Admin full control
    match /grievances/{grievanceId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
