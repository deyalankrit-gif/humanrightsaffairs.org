rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is the designated Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'deydhritiman@gmail.com';
    }

    // Member profiles are restricted to the designated Admin only
    match /memberProfiles/{profileId} {
      allow read, write: if isAdmin();
    }
    
    // Anyone can submit a donation for processing
    // But viewing donation records/history is restricted to the designated Admin
    match /donations/{donationId} {
      allow create: if true;
      allow read: if isAdmin();
    }
  }
}